# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# === RPC URLs ===
# Get free keys from https://www.alchemy.com (or Infura, etc.)
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# === Test wallet ===
# Generate a fresh one — DO NOT use a wallet that holds real funds.
# Easiest: `npx tsx -e "import {privateKeyToAccount, generatePrivateKey} from 'viem/accounts'; const k=generatePrivateKey(); console.log('PRIVATE_KEY=', k); console.log('ADDRESS=', privateKeyToAccount(k).address);"`
# Then fund with Sepolia ETH (https://www.alchemy.com/faucets/ethereum-sepolia)
# And Base Sepolia ETH (https://www.alchemy.com/faucets/base-sepolia)
PRIVATE_KEY=0x_YOUR_TEST_PRIVATE_KEY_HERE

# === Pimlico (ERC-4337 bundler + paymaster) ===
# Free tier: https://dashboard.pimlico.io
PIMLICO_API_KEY=YOUR_PIMLICO_KEY_HERE

# === x402 server (for step 3) ===
X402_PORT=4242

# Where the x402 server receives USDC settlement.
# For the spike: set to your smart account address so you can SEE the USDC move EOA → smart account.
# In production: this is a different agent/seller's address.
X402_RECIPIENT=0x_YOUR_SMART_ACCOUNT_ADDRESS_HERE
